{
  "name": "megaloevolved",
  "displayName": "MegaloEvolved LSP",
  "description": "Language Server for Halo's Megalo scripting language.",
  "version": "0.0.0",
  "private": true,
  "publisher": "blamnetwork",
  "license": "ISC",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "megalo",
    "halo",
    "megaloevolved",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:megalo"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "megalo",
        "aliases": [
          "Megalo",
          "megalo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "megalo",
        "scopeName": "source.megalo",
        "path": "./syntaxes/megalo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "MegaloEvolved",
      "properties": {
        "megaloevolved.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces communication between VS Code and the Megalo language server."
        },
        "megaloevolved.locale": {
          "type": "string",
          "enum": [
            "en",
            "ja"
          ],
          "default": "en",
          "description": "Locale for Megalo diagnostics and hover text."
        },
        "megaloevolved.languageExtensions": {
          "type": "boolean",
          "default": true,
          "description": "Enable MegaloEvolved language extensions (vs MegaloEdit-compatible mode)."
        },
        "megaloevolved.strictStringLiterals": {
          "type": "boolean",
          "default": false,
          "description": "Treat undeclared string literals as errors instead of warnings."
        },
        "megaloevolved.gametypeAuthor": {
          "type": "string",
          "default": "MegaloEvolved",
          "maxLength": 16,
          "description": "Author name written into compiled gametype content metadata."
        },
        "megaloevolved.megaloVersion": {
          "type": "string",
          "enum": [
            "107-mcc",
            "107",
            "106",
            "73",
            "49"
          ],
          "default": "107-mcc",
          "description": "Megalo engine profile used for highlighting, hover, and diagnostics."
        }
      }
    },
    "commands": [
      {
        "command": "megaloevolved.restartServer",
        "title": "MegaloEvolved: Restart Language Server"
      },
      {
        "command": "megaloevolved.selectMegaloVersion",
        "title": "MegaloEvolved: Select Megalo Version"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@megacrow/lsp": "*",
    "@types/node": "^22.15.21",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3"
  }
}
